rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function other(m) {
      return m[0] == request.auth.uid ? m[1] : m[0];
    }

    match /logins/{l} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /profiles/{u} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == u;
    }

    match /users/{u} {
      allow read, write: if request.auth != null && request.auth.uid == u;
    }

    // Приглашение можно отправить только от своего имени и с правильным id.
    match /requests/{r} {
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && r == request.resource.data.from + '_' + request.resource.data.to;
      allow read, delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Общий дедлайн можно создать только в уже существующем чате с этим человеком.
    match /shared/{x} {
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && exists(/databases/$(database)/documents/chats/$(request.resource.data.cid))
        && get(/databases/$(database)/documents/chats/$(request.resource.data.cid)).data.members == request.resource.data.members;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow read, delete: if request.auth != null && request.auth.uid in resource.data.members;
    }

    // Чат (дружба) создаётся только если второй человек прислал приглашение.
    match /chats/{c} {
      allow create: if request.auth != null
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && exists(/databases/$(database)/documents/requests/$(other(request.resource.data.members) + '_' + request.auth.uid));
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow read, delete: if request.auth != null && request.auth.uid in resource.data.members;

      match /msgs/{m} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(c)).data.members;
      }
    }
  }
}
